# AICTE Pre-Scrutiny & Deficiency Resolution Platform
# Environment Configuration Template (.env.example)
# NOTE: Provide secure values in your local .env file. Never commit live secrets.

PROJECT_NAME="AICTE Pre-Scrutiny Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & Cryptography (Generate with: openssl rand -hex 32)
SECRET_KEY="replace_this_with_a_secure_random_64_char_hex_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Relational Database Connection (SQLite local file)
DATABASE_URL="sqlite:///./data/aicte.db"

# CORS Configuration (Comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Storage Configuration
STORAGE_DIR="storage/documents"
MAX_UPLOAD_SIZE_BYTES=15728640

# Abuse & Rate Limiting Controls
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
